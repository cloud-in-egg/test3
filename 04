<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>AI 실시간 수학 퀴즈 (Firebase 버전)</title>
    <!-- MathLive 라이브러리 -->
    <script defer src="https://unpkg.com/mathlive"></script>
    <!-- 구글 로그인 라이브러리 -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <style>
        body { font-family: 'Malgun Gothic', sans-serif; text-align: center; margin: 20px; background-color: #f4f7f6; }
        .section { display: none; padding: 20px; background: white; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); max-width: 600px; margin: 0 auto; }
        .active { display: block; }
        canvas { border: 2px solid #333; border-radius: 5px; cursor: crosshair; background: white; touch-action: none; margin-top: 10px; }
        button { padding: 10px 20px; font-size: 16px; margin-top: 10px; cursor: pointer; background-color: #4CAF50; color: white; border: none; border-radius: 5px; }
        button:hover { background-color: #45a049; }
        input { padding: 10px; font-size: 16px; margin: 5px; width: 80%; }
        ul { list-style: none; padding: 0; }
        li { padding: 8px; font-size: 18px; border-bottom: 1px solid #ddd; }
        math-field {
            font-size: 1.5em;
            padding: 10px;
            margin: 10px auto;
            width: 80%;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: #fff;
        }
    </style>
</head>
<body>

    <h1>📝 실시간 AI 수학 퀴즈</h1>

    <!-- 1. 로그인 화면 -->
    <div id="loginSection" class="section active">
        <h3>로그인 및 입장</h3>
        <p>구글 계정으로 로그인하여 참여하세요.</p>
        
        <!-- 🔑 구글 클라이언트 ID 입력 필요 -->
        <div id="g_id_onload"
             data-client_id="YOUR_CLIENT_ID.apps.googleusercontent.com"
             data-callback="handleCredentialResponse">
        </div>
        <div class="g_id_signin" data-type="standard" data-shape="rectangular" data-theme="outline" data-text="sign_in_with" data-size="large"></div>
        
        <hr style="margin: 20px 0;">
        <p>학생인 경우 닉네임으로 입장하기:</p>
        <input type="text" id="nicknameInput" placeholder="닉네임 입력 (예: 홍길동)">
        <br>
        <button onclick="loginWithNickname()">닉네임으로 입장</button>
    </div>

    <!-- 2. 관리자 화면 -->
    <div id="adminSection" class="section">
        <h2>👨‍🏫 선생님 대시보드 (관리자)</h2>
        <math-field id="questionInput" placeholder="이곳을 클릭해 문제를 출제하세요"></math-field>
        <math-field id="answerInput" placeholder="이곳을 클릭해 정답을 입력하세요"></math-field>
        <br>
        <button onclick="startQuiz()">문제 전송 및 시작</button>
        <h3>학생 제출 현황</h3>
        <ul id="submitStatus"></ul>
    </div>

    <!-- 3. 학생 화면 -->
    <div id="studentSection" class="section">
        <h2 id="welcomeStudent">대기 중...</h2>
        <h3 id="waitingMsg" style="color: blue;">선생님이 문제를 출제하실 때까지 기다려주세요.</h3>
        
        <math-field id="questionDisplay" read-only style="display:none; border:none; background:transparent; font-size: 2em;"></math-field>
        
        <canvas id="drawingBoard" width="400" height="250" style="display:none;"></canvas>
        <br>
        <button id="submitBtn" onclick="submitAnswer()" style="display:none;">정답 제출하기</button>
        <button id="clearBtn" onclick="clearCanvas()" style="display:none; background-color: #f44336;">지우기</button>
        <p id="studentFeedback"></p>
    </div>

    <!-- 4. 실시간 점수판 -->
    <div id="scoreSection" class="section active" style="margin-top: 20px;">
        <h3>🏆 실시간 점수판</h3>
        <ul id="scoreboard"></ul>
    </div>

    <!-- Firebase SDK (Modular 버전) 불러오기 -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getDatabase, ref, set, onValue, update, push } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        // 🔑 [필수] 본인의 파이어베이스 콘솔 정보로 교체하세요!
        const firebaseConfig = {
            apiKey: "YOUR_FIREBASE_API_KEY",
            authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
            databaseURL: "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT_ID.appspot.com",
            messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        let currentUser = null;
        let isAdmin = false;

        // JWT 디코딩 함수 (구글 이메일 추출용)
        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('0' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        }

        // 구글 로그인 콜백
        window.handleCredentialResponse = function(response) {
            const payload = parseJwt(response.credential);
            const email = payload.email;
            const name = payload.name;

            // pjw8022@gmail.com 계정일 경우 자동 관리자 설정
            if (email === 'pjw8022@gmail.com') {
                isAdmin = true;
                currentUser = { id: 'admin_' + Date.now(), name: name, role: 'admin' };
                document.getElementById('loginSection').classList.remove('active');
                document.getElementById('adminSection').classList.add('active');
                alert("관리자(선생님) 권한으로 로그인되었습니다.");
            } else {
                registerStudent(name);
            }
        };

        // 닉네임 로그인
        window.loginWithNickname = function() {
            const nickname = document.getElementById('nicknameInput').value;
            if (!nickname) return alert("닉네임을 입력해주세요!");
            registerStudent(nickname);
        };

        function registerStudent(name) {
            isAdmin = false;
            const studentId = 'student_' + Math.random().toString(36).substr(2, 9);
            currentUser = { id: studentId, name: name, role: 'student' };

            // 파이어베이스에 학생 등록 및 초기 점수 0점 부여
            set(ref(db, 'students/' + studentId), {
                name: name,
                score: 0
            });

            document.getElementById('loginSection').classList.remove('active');
            document.getElementById('studentSection').classList.add('active');
            document.getElementById('welcomeStudent').textContent = `${name} 학생 환영합니다!`;
        }

        // ----------------- 관리자 기능 -----------------
        window.startQuiz = function() {
            if (!isAdmin) return;
            const q = document.getElementById('questionInput').value;
            const a = document.getElementById('answerInput').value;
            if (!q || !a) return alert("문제와 정답을 모두 입력하세요.");

            // 퀴즈 정보 업데이트 및 제출함 초기화
            set(ref(db, 'quiz'), {
                question: q,
                answer: a,
                status: 'started'
            });
            set(ref(db, 'submissions'), {});
            document.getElementById('submitStatus').innerHTML = "";
            alert("문제가 전송되었습니다!");
        };

        // 실시간 제출 현황 감시 (관리자용)
        onValue(ref(db, 'submissions'), (snapshot) => {
            if (!isAdmin) return;
            const subs = snapshot.val() || {};
            const statusUl = document.getElementById('submitStatus');
            statusUl.innerHTML = "";
            Object.values(subs).forEach(sub => {
                const li = document.createElement('li');
                li.textContent = `✅ ${sub.name} 학생 제출 완료`;
                statusUl.appendChild(li);
            });
        });

        // ----------------- 학생 기능 -----------------
        const canvas = document.getElementById('drawingBoard');
        const ctx = canvas.getContext('2d');
        let isDrawing = false;

        function startDrawing(e) { isDrawing = true; draw(e); }
        function stopDrawing() { isDrawing = false; ctx.beginPath(); }
        function draw(e) {
            if (!isDrawing) return;
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#000';
            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX || e.touches[0].clientX) - rect.left;
            const y = (e.clientY || e.touches[0].clientY) - rect.top;
            ctx.lineTo(x, y);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x, y);
            e.preventDefault();
        }

        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('touchstart', startDrawing, {passive: false});
        canvas.addEventListener('touchend', stopDrawing);
        canvas.addEventListener('touchmove', draw, {passive: false});

        window.clearCanvas = function() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        };

        window.submitAnswer = function() {
            if (!currentUser) return;
            const imageData = canvas.toDataURL('image/png');
            
            // 파이어베이스에 답안 제출 기록
            set(ref(db, 'submissions/' + currentUser.id), {
                name: currentUser.name,
                image: imageData
            });
            document.getElementById('studentFeedback').textContent = "제출 완료! 결과 대기 중...";
            document.getElementById('submitBtn').style.display = "none";
        };

        // 퀴즈 시작 상태 실시간 감지 (학생용)
        onValue(ref(db, 'quiz'), (snapshot) => {
            const quizData = snapshot.val();
            if (quizData && quizData.status === 'started' && !isAdmin) {
                document.getElementById('waitingMsg').style.display = "none";
                const qDisplay = document.getElementById('questionDisplay');
                qDisplay.style.display = "block";
                qDisplay.value = quizData.question;
                document.getElementById('studentFeedback').textContent = "";
                canvas.style.display = "inline-block";
                document.getElementById('submitBtn').style.display = "inline-block";
                document.getElementById('clearBtn').style.display = "inline-block";
                window.clearCanvas();
            }
        });

        // ----------------- 실시간 점수판 연동 -----------------
        onValue(ref(db, 'students'), (snapshot) => {
            const students = snapshot.val() || {};
            const board = document.getElementById('scoreboard');
            board.innerHTML = "";
            const sorted = Object.values(students).sort((a, b) => b.score - a.score);
            sorted.forEach(s => {
                const li = document.createElement('li');
                li.textContent = `${s.name} : ${s.score}점`;
                board.appendChild(li);
            });
        });
    </script>
</body>
</html>
